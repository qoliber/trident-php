# Multi-stage build for Trident
FROM rust:1.83-bookworm AS builder

WORKDIR /build

# Copy source code
COPY Cargo.toml Cargo.lock ./
COPY trident ./trident
COPY trident-core ./trident-core
COPY trident-cli ./trident-cli
COPY trident-snap ./trident-snap

# Build release binaries
RUN cargo build --release -p trident -p trident-cli

# Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy binaries from builder
COPY --from=builder /build/target/release/trident /usr/local/bin/trident
COPY --from=builder /build/target/release/trident-cli /usr/local/bin/trident-cli

# Create config directory
RUN mkdir -p /etc/trident /var/lib/trident

EXPOSE 8080 9100 9191

ENTRYPOINT ["/usr/local/bin/trident"]
CMD ["-c", "/etc/trident/trident.toml"]
